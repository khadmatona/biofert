# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real credentials.

# --- Shopify --------------------------------------------------------------
# Your store's *.myshopify.com domain (no https://, no trailing slash).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# This store's Shopify app is a Dev Dashboard custom app, which does not
# hand out a static Admin API token. Instead these are exchanged for a
# short-lived offline access token via OAuth 2.0 Client Credentials Grant —
# see src/modules/shopify/shopify.service.ts (same pattern as
# ../scripts/shopify-migration/admin-client.ts). Find these in the Shopify
# Dev Dashboard -> your app -> Client credentials. SHOPIFY_CLIENT_SECRET is
# as sensitive as a password.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Admin GraphQL API version to call. Keep in sync with the Storefront API
# version pinned in ../lib/shopify/client.ts unless you have a reason not to.
SHOPIFY_ADMIN_API_VERSION=2025-01

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/biofertmaroc

# --- Frontend / CORS --------------------------------------------------------
# The Next.js storefront's origin(s). Comma-separated if the storefront is
# reachable on more than one (e.g. apex + www). Only these origins are
# allowed to call the API — never use "*" in production.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Admin endpoints ---------------------------------------------------------
# Bearer/x-api-key value required on GET /api/orders, GET /api/orders/:id,
# and PATCH /api/orders/:id/status. Generate a long random value, e.g.
# `openssl rand -hex 32`.
ADMIN_API_KEY=change_me_to_a_long_random_value

PORT=4000
